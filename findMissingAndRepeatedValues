class Solution {
    public int[] findMissingAndRepeatedValues(int[][] grid) {
        int n = grid.length;
        int totalNumbers = n * n;
        
        long sum = 0;
        long sumSquares = 0;
        
        // Calculate actual sum and sum of squares
        for (int[] row : grid) {
            for (int num : row) {
                sum += num;
                sumSquares += num * num;
            }
        }
        
        // Expected sum and sum of squares for 1 to totalNumbers
        long expectedSum = (long)totalNumbers * (totalNumbers + 1) / 2;
        long expectedSumSquares = (long)totalNumbers * (totalNumbers + 1) * (2 * totalNumbers + 1) / 6;
        
        // Differences
        long sumDiff = sum - expectedSum;        // x - y
        long sumSquaresDiff = sumSquares - expectedSumSquares; // x² - y²
        
        // Solve for x (repeating) and y (missing)
        int xPlusY = (int)(sumSquaresDiff / sumDiff);
        int x = (int)((sumDiff + xPlusY) / 2);
        int y = xPlusY - x;
        
        return new int[]{x, y};
    }
}
